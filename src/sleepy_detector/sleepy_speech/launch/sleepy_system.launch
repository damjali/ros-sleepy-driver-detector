    <node name="sleepy_vision" pkg="sleepy_speech" type="sleepy_vision.py" output="screen" />
    <node name="speech_node" pkg="sleepy_speech" type="speech_node.py" output="screen" />
    <node name="soundplay_node" pkg="sound_play" type="soundplay_node.py" output="screen" />
    <node name="sleepy_speech_node" pkg="sleepy_speech" type="speech_node.py" output="screen" />
</launch>
